# Get a key from https://platform.openai.com/api-keys
# Never commit .env — keep this file local only.
OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to gpt-4o-mini (vision-capable, cost-effective)
# OPENAI_MODEL=gpt-4o-mini

# API server port (local: npm run dev:api). Coolify sets PORT automatically.
PORT=8787

# SQLite database
# Local dev (relative to prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Coolify production (with /app/prisma volume):
# DATABASE_URL=file:/app/prisma/dev.db

# Required for signup/login sessions — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Receipt image storage (mount as a persistent volume in Coolify)
# UPLOAD_PATH=/app/data/uploads
